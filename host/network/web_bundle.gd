## Contenido del archivo `name` o PackedByteArray vacío si no existe.
static func get_file(name: String) -> PackedByteArray:
	if not FILES.has(name):
		return PackedByteArray()
	return Marshalls.base64_to_raw("".join(FILES[name]))


static func names() -> Array:
	return FILES.keys()
